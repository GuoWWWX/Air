{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Air Proxy",
  "version": "1.1.0",
  "identifier": "app.air.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Air Proxy", "create": false, "visible": false, "decorations": false, "dragDropEnabled": false, "width": 1280, "height": 780, "minWidth": 840, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["../src/assets/air.ico"] }
}
