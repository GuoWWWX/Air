{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Air Proxy",
  "mainBinaryName": "air-proxy",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "windows/Mihomo-LICENSE.txt": "Mihomo-LICENSE.txt",
      "windows/Mihomo-build-info.txt": "Mihomo-build-info.txt",
      "../.cache/air/windows-x64/Wintun-LICENSE.txt": "Wintun-LICENSE.txt",
      "../src/assets/air.ico": "Air-Proxy.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "template": "windows/installer.nsi",
        "customLanguageFiles": {
          "English": "windows/nsis-languages/English.nsh",
          "SimpChinese": "windows/nsis-languages/SimpChinese.nsh"
        },
        "installerIcon": "../src/assets/air.ico",
        "installerHooks": "windows/shortcut-icons.nsh",
        "uninstallerIcon": "../src/assets/air.ico"
      }
    }
  }
}
